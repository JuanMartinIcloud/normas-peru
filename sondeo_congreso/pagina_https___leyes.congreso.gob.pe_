    <script type="text/javascript">
        function doClick(btnCon, e) {   //the purpose of this function is to allow the enter key to 
            //point to the correct button to click.
            var key;
            if (window.event)
                key = window.event.keyCode;     //IE
            else
                key = e.which;     //firefox
            if (key == 13) {
                //Get the button the user wants to have clicked
                var btnC = document.getElementById(btnCon);
                if (btnC != null) { //If we find the button click it
                    var txt = document.getElementById("ctl00_ContentPlaceHolder1_TxtBuscar");
                    var txtNormaI = document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaI");
                    var txtNormaF = document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaF");
                    if (txt.value != "" || txtNormaI.value != "" || txtNormaI.value != "") {
                        btnC.click();
                        event.keyCode = 0
                    }
                }
            }
        }
        //-----------------------------------------------------------------------------------------//
        function MostrarOcultar() {
            var Fila1 = document.getElementById("fecha");
            var Fila2 = document.getElementById("texto");
            var Fila3 = document.getElementById("norma");
            var Combo = document.getElementById("ctl00_ContentPlaceHolder1_DdlTipoBusqueda");
            if (Combo.value == "3") { //Texto
                Fila1.style.display = "none";
                Fila2.style.display = "block";
                Fila3.style.display = "none";
                document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaIni").value = "";
                document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaFin").value = "";
                document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaI").value = "";
                document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaF").value = "";
                document.getElementById("ctl00_ContentPlaceHolder1_TxtBuscar").focus();
            } else {
                if (Combo.value == "4") { //Norma
                    Fila1.style.display = "none";
                    Fila2.style.display = "none";
                    Fila3.style.display = "block";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaIni").value = "";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaFin").value = "";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtBuscar").value = "";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaI").focus();
                } else { //Fechas
                    Fila1.style.display = "block";
                    Fila2.style.display = "none";
                    Fila3.style.display = "none";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaI").value = "";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaF").value = "";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtBuscar").value = "";
                    document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaIni").focus();
                }
            }
        }
        //-----------------------------------------------------------------------------------------//
        function Validar() {
            var fechaini = document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaIni");
            var fechafin = document.getElementById("ctl00_ContentPlaceHolder1_TxtFechaFin");
            var normaini = document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaI");
            var normafin = document.getElementById("ctl00_ContentPlaceHolder1_TxtNroNormaF");
            /* Valida fecha en formato dd/mm/yyyy */
            var Expresion = /^[0-9][0-9]\/[0-9][0-9]\/[0-9][0-9][0-9][0-9]$/

            if (normaini.value == "" && normafin.value != "") {
                alert("Introduzca Norma Inicial.");
                normaini.focus();
                return false;
            }

            if (fechaini.value == "" && fechafin.value != "") {
                alert("Introduzca Fecha Inicial.");
                fechaini.focus();
                return false;
            }

            if (fechaini.value != "") {
                if (!Expresion.test(fechaini.value)) {
                    alert("Formato de Fecha debe ser dd/mm/aaaa.");
                    fechaini.focus();
                    return false;
                } else {
                    var valor = FechaCorrecta(fechaini);
                    if (valor == false) { fechaini.focus(); return false; }
                }
            }

            if (fechafin.value != "") {
                if (!Expresion.test(fechafin.value)) {
                    alert("Formato de Fecha debe ser dd/mm/aaaa.");
                    fechafin.focus();
                    return false;
                } else {
                    var valor = FechaCorrecta(fechafin);
                    if (valor == false) { fechafin.focus(); return false; }
                }
            }

            var auxfi = Date.parse(fechaini.value);
            var auxff = Date.parse(fechafin.value);

            if (ComparaFechas(fechaini, fechafin)) {
                alert("Fecha Inicial mayor que Fecha Final, Corrija.");
                return false;
            }

            if (parseInt(fechaini.value.substring(6), 10) < parseInt(1904)) {
                alert("Rango de fechas debe estar comprendida desde 01/01/1904 a la actualidad.");
                return false;
            }

            if (parseInt(fechafin.value.substring(6), 10) < parseInt(1904)) {
                alert("Rango de fechas debe estar comprendida desde 01/01/1904 a la actualidad.");
                return false;
            }
            // Devuelve true si todo es correcto
            return true;
        } // cierra funcion validar
        function ComparaFechas(fecha1, fecha2) {
            var xanio = parseInt(fecha1.value.substring(6), 10);
            var xmes = parseInt(fecha1.value.substring(3, 5), 10);
            var xdia = parseInt(fecha1.value.substring(0, 2), 10);

            var yanio = parseInt(fecha2.value.substring(6), 10);
            var ymes = parseInt(fecha2.value.substring(3, 5), 10);
            var ydia = parseInt(fecha2.value.substring(0, 2), 10);

            if (xanio > yanio) {
                return true;
            } else {
                if (xanio == yanio) {
                    if (xmes > ymes) {
                        return true;
                    } else {
                        if (xmes == ymes) {
                            if (xdia > ydia) {
                                return true;
                            } else {
                                return false;
                            }
                        } else { return false; }
                    }
                } else { return false; }
            }
        }
        function FechaCorrecta(fecha) {
            var dia = parseInt(fecha.value.substring(0, 2), 10);
            var mes = parseInt(fecha.value.substring(3, 5), 10);
            var ann = parseInt(fecha.value.substring(6), 10);
            switch (mes) {
                case 1:
                case 3:
                case 5:
                case 7:
                case 8:
                case 10:
                case 12:
                    numDias = 31;
                    break;
                case 4: case 6: case 9: case 11:
                    numDias = 30
                    break;
                case 2:
                    if (comprobarSiBisisesto(ann)) {
                        numDias = 29;
                    } else { numDias = 28 };
                    break;
                default:
                    alert("Fecha introducida es incorrecta. El formato correcto es dd/mm/aaaa");
                    return false;
            }
            if (dia > numDias || dia == 0) {
                alert("Fecha introducida es incorrecta. El formato correcto es dd/mm/aaaa");
                return false;
            }
        } // cierra funcion FechaCorrecta
        function comprobarSiBisisesto(ann) {
            if ((ann % 100 != 0) && ((ann % 4 == 0) || (ann % 400 == 0))) {
                return true;
            } else {
                return false;
            }
        }
    </script>

